# HTTP management server
HTTP_HOST=0.0.0.0
HTTP_PORT=19720
DB_PATH=./data/sim.db
EXECUTOR_ID=sim-executor

# Latest quote cache: memory only; idle retention and symbol capacity
QUOTE_RETENTION_MS=3600000
QUOTE_MAX_SYMBOLS=10000

# Optional gateway bridge
SIM_SERVER_URL=http://127.0.0.1:19720
WS_URL=ws://127.0.0.1:19600/api/v1/ws/executor
BACKEND_URL=http://127.0.0.1:19600
EXECUTOR_TYPE=simulate
GATEWAY_CACHE_DIR=./data/gateway-cache

